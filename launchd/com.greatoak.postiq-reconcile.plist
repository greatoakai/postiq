<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.greatoak.postiq-reconcile — THE daily PostIQ report.

  Runs at 8:00 AM, after run_daily.sh (7:00) has synced and archived yesterday's
  Square CSV. Reconciles yesterday's poller ledger against that CSV and emails
  the result to Hannah (cc Travis): what still has to be posted by hand in TA,
  plus the rolling 45-day list of payments that never posted automatically.
  Posts nothing itself.

  Since the 2026-06-18 live cutover this is the only daily staff email — the
  batch no longer sends one. If this job stops running, nobody hears about
  failed postings.

  Install:
    cp launchd/com.greatoak.postiq-reconcile.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.greatoak.postiq-reconcile.plist
  Once staff confirm they've worked the outstanding list:
    python3 scripts/reconcile.py --clear-through MM.DD.YYYY
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.greatoak.postiq-reconcile</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/travmegsam/Developer/postiq-dev/scripts/reconcile.py</string>
        <string>--email</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/travmegsam/Developer/postiq-dev/logs/reconcile_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/travmegsam/Developer/postiq-dev/logs/reconcile_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/travmegsam</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
